<style>
  @page {
    size: A4;
    margin: 2.5cm 2cm 2.5cm 2cm;
    mso-header-margin: 1cm;
    mso-footer-margin: 1cm;
  }
  body {
    font-family: Calibri, sans-serif;
    font-size: 11pt;
    color: #1a1a2e;
    line-height: 1.4;
  }
  h1 {
    font-family: Calibri, sans-serif;
    font-size: 22pt;
    font-weight: bold;
    color: #1a47e8;
    border-bottom: 3px solid #1a47e8;
    padding-bottom: 6pt;
    margin-bottom: 6pt;
    margin-top: 0;
  }
  h2 {
    font-family: Calibri, sans-serif;
    font-size: 14pt;
    font-weight: bold;
    color: #1a47e8;
    background-color: #eef2ff;
    padding: 5pt 8pt;
    margin-top: 18pt;
    margin-bottom: 4pt;
    border-left: 4pt solid #1a47e8;
  }
  h3 {
    font-family: Calibri, sans-serif;
    font-size: 11pt;
    font-weight: bold;
    color: #374151;
    margin-top: 12pt;
    margin-bottom: 3pt;
  }
  .meta-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 16pt;
    font-size: 10pt;
  }
  .meta-table td {
    padding: 4pt 8pt;
    border: 1px solid #d1d5db;
  }
  .meta-table td:first-child {
    font-weight: bold;
    background-color: #f3f4f6;
    width: 30%;
  }
  table.test-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 9.5pt;
    margin-bottom: 10pt;
  }
  table.test-table th {
    background-color: #1a47e8;
    color: white;
    font-weight: bold;
    padding: 5pt 6pt;
    text-align: left;
    border: 1px solid #1a47e8;
  }
  table.test-table td {
    padding: 4pt 6pt;
    border: 1px solid #d1d5db;
    vertical-align: top;
  }
  table.test-table tr:nth-child(even) td {
    background-color: #f9fafb;
  }
  table.test-table td:first-child {
    font-weight: bold;
    color: #1a47e8;
    width: 5%;
    white-space: nowrap;
  }
  table.test-table td:last-child {
    width: 16%;
  }
  .result-col {
    background-color: #fffbeb !important;
  }
  .page-break { page-break-before: always; }
  .footer-note {
    font-size: 9pt;
    color: #6b7280;
    border-top: 1px solid #e5e7eb;
    margin-top: 20pt;
    padding-top: 6pt;
  }
  p { margin: 4pt 0; }
</style>
</head>
<body>

<h1>CyberWall — User Acceptance Testing (UAT) Test Plan</h1>

<table class="meta-table">
  <tr><td>Project</td><td>ProCyberWall — Managed Firewall SaaS</td></tr>
  <tr><td>Test Date</td><td>April 2026</td></tr>
  <tr><td>Environment</td><td>http://localhost:3001</td></tr>
  <tr><td>Tester</td><td></td></tr>
  <tr><td>Result Key</td><td>PASS &nbsp;|&nbsp; FAIL: &lt;what happened&gt; &nbsp;|&nbsp; SKIP</td></tr>
</table>

<!-- ═══════════════════════════════════════════════════════ MODULE 1 -->
<h2>MODULE 1 — Landing Page (index.html)</h2>

<table class="test-table">
  <tr>
    <th>#</th>
    <th>Test Case</th>
    <th>Steps</th>
    <th>Expected Result</th>
    <th>Result</th>
  </tr>
  <tr><td>1.1</td><td>Page loads</td><td>Open http://localhost:3001</td><td>Hero section visible, no console errors</td><td class="result-col"></td></tr>
  <tr><td>1.2</td><td>Hero headline</td><td>Read hero text</td><td>"Enterprise-grade firewall protection — without the enterprise price tag." visible</td><td class="result-col"></td></tr>
  <tr><td>1.3</td><td>Hero CTAs side-by-side</td><td>View hero on desktop and mobile</td><td>"Start 7-day free trial" and "Check your security score" are side by side, equal width</td><td class="result-col"></td></tr>
  <tr><td>1.4</td><td>AI threat badge</td><td>Check hero threat badges</td><td>"AI-powered attack intercepted" badge with red pulse dot visible</td><td class="result-col"></td></tr>
  <tr><td>1.5</td><td>AI Threats section</td><td>Scroll down the page</td><td>Dedicated dark-background AI Threats section present between Features and Pricing</td><td class="result-col"></td></tr>
  <tr><td>1.6</td><td>AI Attack Protection card</td><td>View Features section</td><td>"AI Attack Protection" feature card with red tint border present</td><td class="result-col"></td></tr>
  <tr><td>1.7</td><td>Pricing section</td><td>View Pricing</td><td>Starter $29, Pro $59, Business $99 — correct amounts</td><td class="result-col"></td></tr>
  <tr><td>1.8</td><td>7-day free trial mention</td><td>View any CTA or pricing</td><td>Trial mentioned clearly</td><td class="result-col"></td></tr>
  <tr><td>1.9</td><td>No "small businesses" in visible text</td><td>Scan all visible copy</td><td>"small" not visible in hero, features, or scanner section</td><td class="result-col"></td></tr>
  <tr><td>1.10</td><td>Wally chat widget</td><td>Click chat bubble (bottom-right)</td><td>Chat opens, Wally responds</td><td class="result-col"></td></tr>
  <tr><td>1.11</td><td>Wally AI response — AI attacks</td><td>Type "what protection do you offer against AI attacks?"</td><td>Wally gives relevant answer about AI threat protection</td><td class="result-col"></td></tr>
  <tr><td>1.12</td><td>Security score CTA</td><td>Click "Check your website security score"</td><td>Navigates to auth/scanner page</td><td class="result-col"></td></tr>
  <tr><td>1.13</td><td>Start free trial CTA</td><td>Click "Start 7-day free trial"</td><td>Navigates to auth signup page</td><td class="result-col"></td></tr>
  <tr><td>1.14</td><td>No "WAF" in visible text</td><td>Scan all visible copy on page</td><td>"Firewall" used instead of "WAF" everywhere</td><td class="result-col"></td></tr>
</table>

